{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: the start page, settings, and (in a later change) the file editor. It cannot read or write notes; the Quick Notes window owns them.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-confirm-and-open-url",
    "allow-show-alert-dialog",
    "allow-clip-set-config",
    "allow-clip-set-theme",
    "allow-quit-handler-ready",
    "allow-quit-window-done",
    "allow-open-accessibility-settings",
    "allow-qn-get-config",
    "allow-qn-set-hotkey",
    "allow-qn-dismiss-intro",
    "allow-qn-show"
  ]
}
