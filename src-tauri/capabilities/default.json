{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: the start page, settings (including importing a theme file), and the file editor, which reaches only files the user chose. It cannot read or write notes; the Quick Notes window owns them. It can turn agent access on and off and set its permissions, as Quick Notes can. It can install and remove the sodilaud command-line tool.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-confirm-and-open-url",
    "allow-show-alert-dialog",
    "allow-cli-tool-offer",
    "allow-import-file-native",
    "allow-clip-set-config",
    "allow-clip-set-theme",
    "allow-quit-handler-ready",
    "allow-quit-window-done",
    "allow-open-accessibility-settings",
    "allow-qn-get-config",
    "allow-qn-set-hotkey",
    "allow-qn-dismiss-intro",
    "allow-qn-show",
    "allow-file-open-dialog",
    "allow-file-save-as-dialog",
    "allow-file-lists",
    "allow-file-set-open",
    "allow-file-take-pending",
    "allow-file-forget-recent",
    "allow-file-confirm-discard",
    "allow-file-doc-open",
    "allow-file-doc-open-sibling",
    "allow-file-doc-push",
    "allow-file-doc-pull",
    "allow-file-doc-close",
    "allow-file-doc-save",
    "allow-file-doc-resolve",
    "allow-comments-get",
    "allow-comment-add",
    "allow-comment-edit",
    "allow-comment-delete",
    "allow-comment-resolve",
    "allow-comment-mark-read",
    "allow-comment-resend",
    "allow-comments-send-review",
    "allow-comments-clear-resolved",
    "allow-coedit-get-state",
    "allow-coedit-set-hold",
    "allow-get-mcp-connection-info",
    "allow-get-mcp-state",
    "allow-start-mcp-server",
    "allow-set-mcp-permissions",
    "allow-stop-mcp-server",
    "allow-coedit-integration-plan",
    "allow-coedit-integration-install",
    "allow-coedit-integration-remove"
  ]
}
