{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quicknotes",
  "description": "The Quick Notes panel, the only window that shows the notes collection: it renders the registry Rust keeps, sends text changes and sidebar edits, connects workspaces, imports and exports, and turns agent access on and off. qn_close and qn_start_drag hide and move only this window.",
  "windows": [
    "quicknotes"
  ],
  "permissions": [
    "core:default",
    "allow-confirm-and-open-url",
    "allow-save-file-native",
    "allow-import-file-native",
    "allow-select-db-file",
    "allow-show-alert-dialog",
    "allow-notes-boot",
    "allow-notes-import-local",
    "allow-notes-connect",
    "allow-notes-disconnect",
    "allow-notes-sync-structure",
    "allow-notes-trash",
    "allow-notes-restore",
    "allow-notes-empty-trash",
    "allow-notes-vacuum",
    "allow-doc-push",
    "allow-doc-pull",
    "allow-get-mcp-connection-info",
    "allow-get-mcp-state",
    "allow-start-mcp-server",
    "allow-set-mcp-permissions",
    "allow-stop-mcp-server",
    "allow-quit-handler-ready",
    "allow-quit-window-done",
    "allow-qn-close",
    "allow-qn-start-drag",
    "allow-qn-get-config",
    "allow-show-main-window"
  ]
}
