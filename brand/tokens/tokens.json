{
  "$description": "Sodilaud design tokens (DTCG format). Same values as tokens.css, which is the CSS source of truth for roles.",
  "color": {
    "$type": "color",
    "brand": {
      "ink": {
        "$value": "#181e21",
        "$description": "Icon outlines, dark ground"
      },
      "ink-raised": {
        "$value": "#242e2e",
        "$description": "Raised dark surface (Executive sidebar)"
      },
      "umber": {
        "$value": "#543529",
        "$description": "Dark hairlines (Executive border)"
      },
      "amber": {
        "$value": "#fdc78e",
        "$description": "The scrap; dark-mode text. 11.0:1 on ink"
      },
      "teal": {
        "$value": "#1e959d",
        "$description": "Accent. 4.7:1 on ink"
      },
      "teal-deep": {
        "$value": "#1b676b",
        "$description": "Dark selection (Executive selection)"
      },
      "coral": {
        "$value": "#ee5a3c",
        "$description": "Icon tile. Ink on coral 4.9:1"
      },
      "paper": {
        "$value": "#f6f2ea",
        "$description": "Light ground. Ink on paper 15.1:1"
      },
      "paper-raised": {
        "$value": "#ece6db"
      },
      "teal-ink": {
        "$value": "#146a71",
        "$description": "Teal for text on paper. 5.7:1"
      },
      "coral-ink": {
        "$value": "#b8351b",
        "$description": "Coral for text on paper. 5.3:1"
      }
    },
    "dark": {
      "bg": {
        "$value": "{color.brand.ink}"
      },
      "surface": {
        "$value": "{color.brand.ink-raised}"
      },
      "text": {
        "$value": "{color.brand.amber}"
      },
      "text-muted": {
        "$value": "#bfa285"
      },
      "accent": {
        "$value": "{color.brand.teal}"
      },
      "accent-fg": {
        "$value": "{color.brand.ink}"
      },
      "brand": {
        "$value": "{color.brand.coral}"
      },
      "brand-fg": {
        "$value": "{color.brand.ink}"
      },
      "selection": {
        "$value": "{color.brand.teal-deep}"
      },
      "border": {
        "$value": "{color.brand.umber}"
      },
      "selection-fg": {
        "$value": "{color.brand.paper}",
        "$description": "5.9:1 on selection; amber on it is only 4.3:1"
      }
    },
    "light": {
      "bg": {
        "$value": "{color.brand.paper}"
      },
      "surface": {
        "$value": "{color.brand.paper-raised}"
      },
      "text": {
        "$value": "{color.brand.ink}"
      },
      "text-muted": {
        "$value": "#5b6468"
      },
      "accent": {
        "$value": "{color.brand.teal-ink}"
      },
      "accent-fg": {
        "$value": "{color.brand.paper}"
      },
      "brand": {
        "$value": "{color.brand.coral-ink}"
      },
      "brand-fg": {
        "$value": "{color.brand.paper}"
      },
      "selection": {
        "$value": "#cde5e3"
      },
      "border": {
        "$value": "#d4ccbf"
      },
      "selection-fg": {
        "$value": "{color.brand.ink}"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "mono": {
        "$value": [
          "JetBrains Mono",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "Liberation Mono",
          "monospace"
        ]
      },
      "sans": {
        "$value": [
          "Inter",
          "ui-sans-serif",
          "-apple-system",
          "BlinkMacSystemFont",
          "Segoe UI",
          "sans-serif"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "11px"
      },
      "sm": {
        "$value": "12px"
      },
      "base": {
        "$value": "14px"
      },
      "md": {
        "$value": "16px"
      },
      "lg": {
        "$value": "20px"
      },
      "xl": {
        "$value": "28px"
      },
      "2xl": {
        "$value": "44px"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "strong": {
        "$value": 600
      }
    },
    "leading": {
      "$type": "number",
      "tight": {
        "$value": 1.15
      },
      "base": {
        "$value": 1.5
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "0": {
      "$value": "0"
    },
    "1": {
      "$value": "2px"
    },
    "2": {
      "$value": "4px"
    },
    "3": {
      "$value": "8px"
    },
    "tile": {
      "$value": "22.4%",
      "$description": "App icon tile, as a share of its side"
    }
  },
  "stroke": {
    "$type": "dimension",
    "mark": {
      "$value": "6%",
      "$description": "Icon outline weight, as a share of the tile"
    },
    "ui": {
      "$value": "2px",
      "$description": "UI glyphs on a 24px grid"
    },
    "hairline": {
      "$value": "1px"
    },
    "focus": {
      "$value": "2px",
      "$description": "Focus ring, offset 2px, accent colour, no blur"
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": "2px"
    },
    "2": {
      "$value": "4px"
    },
    "3": {
      "$value": "8px"
    },
    "4": {
      "$value": "12px"
    },
    "5": {
      "$value": "16px"
    },
    "6": {
      "$value": "24px"
    },
    "7": {
      "$value": "32px"
    },
    "8": {
      "$value": "48px"
    },
    "9": {
      "$value": "64px"
    }
  },
  "elevation": {
    "0": {
      "$type": "shadow",
      "$value": "none"
    },
    "1-dark": {
      "$type": "shadow",
      "$value": "0 8px 24px rgba(0, 0, 0, 0.35)",
      "$description": "Popovers and menus only"
    },
    "1-light": {
      "$type": "shadow",
      "$value": "0 8px 24px rgba(24, 30, 33, 0.16)"
    },
    "glow": {
      "$type": "shadow",
      "$value": "none",
      "$description": "No glow anywhere"
    }
  },
  "motion": {
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.16,
        1,
        0.3,
        1
      ]
    },
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "90ms"
      },
      "base": {
        "$value": "140ms"
      },
      "slow": {
        "$value": "220ms"
      }
    }
  }
}
